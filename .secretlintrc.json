{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "환경 변수 파일 (.env.example만 커밋 가능)",
            "filePathGlobs": [
              "**/.env",
              "**/.env.local",
              "**/.env.development",
              "**/.env.production",
              "**/.env.test",
              "**/.env.*.local"
            ]
          },
          {
            "name": "슬리피 서버 전용 비밀 키",
            "patterns": [
              "/SUPABASE_SERVICE_ROLE_KEY[ \\t]*=[ \\t]*[^\\s#]+/",
              "/TURNSTILE_SECRET_KEY[ \\t]*=[ \\t]*[^\\s#]+/",
              "/MAIL_API_KEY[ \\t]*=[ \\t]*[^\\s#]+/",
              "/sb_secret_[A-Za-z0-9_-]{10,}/"
            ]
          }
        ]
      }
    }
  ]
}
